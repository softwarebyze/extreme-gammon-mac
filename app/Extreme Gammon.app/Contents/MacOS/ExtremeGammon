#!/bin/bash
set -euo pipefail
# Sikarugir FileUtilsError 1 if PATH has more than one chmod.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"

ENGINE="WS12WineSikarugir10.0_6"
TEMPLATE="Template-1.0.11"
ENGINE_URL="https://github.com/Sikarugir-App/Engines/releases/download/v1.0/${ENGINE}.tar.xz"
TEMPLATE_URL="https://github.com/Sikarugir-App/Wrapper/releases/download/v1.0/${TEMPLATE}.tar.xz"
XG_URL="https://www.extremegammon.com/xg2install.exe"

WRAPPER="$HOME/Applications/Extreme Gammon.app"
CACHE="$HOME/Library/Application Support/ExtremeGammon"
LOG="$HOME/Desktop/Extreme Gammon install log.txt"

# Official Inno Setup path inside the Wine prefix (32-bit).
XG_WIN_PATH="/Program Files (x86)/eXtreme Gammon 2/eXtremeGammon2.exe"

log() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG"; }
note() { log "$1"; printf '%s\n' "$1" > "$HOME/Desktop/Extreme Gammon status.txt"; }

# Return 0 if the running macOS is at least major.minor.patch.
# Unknown or unparsable versions are allowed so a bad sw_vers cannot brick launch.
macos_at_least() {
  local need_maj="$1" need_min="$2" need_pat="$3"
  local ver maj min pat
  ver="$(/usr/bin/sw_vers -productVersion 2>/dev/null || true)"
  case "$ver" in
    ''|*[!0-9.]*) return 0 ;;
  esac
  local IFS=.
  set -- $ver
  maj="${1:-0}"
  min="${2:-0}"
  pat="${3:-0}"
  maj="${maj%%[!0-9]*}"
  min="${min%%[!0-9]*}"
  pat="${pat%%[!0-9]*}"
  case "$maj" in ''|*[!0-9]*) return 0 ;; esac
  case "$min" in ''|*[!0-9]*) min=0 ;; esac
  case "$pat" in ''|*[!0-9]*) pat=0 ;; esac
  if [ "$maj" -ne "$need_maj" ]; then
    [ "$maj" -gt "$need_maj" ]
    return $?
  fi
  if [ "$min" -ne "$need_min" ]; then
    [ "$min" -gt "$need_min" ]
    return $?
  fi
  [ "$pat" -ge "$need_pat" ]
}

require_macos() {
  local ver arch msg
  ver="$(/usr/bin/sw_vers -productVersion 2>/dev/null || echo unknown)"
  arch="$(/usr/bin/uname -m 2>/dev/null || true)"
  log "macOS=$ver arch=${arch:-unknown}"
  if [ "$arch" = "arm64" ]; then
    macos_at_least 11 0 0 && return 0
    msg="Extreme Gammon for Mac needs macOS 11 Big Sur or later on Apple silicon."
  else
    macos_at_least 10 15 4 && return 0
    msg="Extreme Gammon for Mac needs macOS 10.15.4 Catalina or later on Intel Macs."
  fi
  note "This Mac is on macOS ${ver}, but ${msg}"
  /usr/bin/osascript -e "display dialog \"${msg}\" buttons {\"OK\"} default button \"OK\" with title \"Extreme Gammon\"" >/dev/null 2>&1 || true
  exit 0
}

# Wine prefix may live at SharedSupport/prefix (Sikarugir) or Contents.
resolve_prefix() {
  local p
  PREFIX="$WRAPPER/Contents"
  for p in "$WRAPPER/Contents/SharedSupport/prefix" "$WRAPPER/Contents"; do
    if [[ -d "$p/drive_c/windows" ]]; then
      PREFIX="$p"
      return 0
    fi
  done
  if [[ -d "$WRAPPER/Contents/SharedSupport/prefix" ]]; then
    PREFIX="$WRAPPER/Contents/SharedSupport/prefix"
  else
    PREFIX="$WRAPPER/Contents"
  fi
}

# Print the installed exe path if it exists. Check both prefixes and both Program Files dirs.
find_xg_exe() {
  local p pf candidate
  for p in "$WRAPPER/Contents/SharedSupport/prefix" "$WRAPPER/Contents"; do
    for pf in "Program Files (x86)" "Program Files"; do
      candidate="$p/drive_c/$pf/eXtreme Gammon 2/eXtremeGammon2.exe"
      if [[ -f "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
  done
  return 1
}

xg_ready() { find_xg_exe >/dev/null; }

win_path_for_exe() {
  local exe="$1"
  case "$exe" in
    *"/Program Files (x86)/eXtreme Gammon 2/"*)
      printf '%s\n' "/Program Files (x86)/eXtreme Gammon 2/eXtremeGammon2.exe"
      ;;
    *"/Program Files/eXtreme Gammon 2/"*)
      printf '%s\n' "/Program Files/eXtreme Gammon 2/eXtremeGammon2.exe"
      ;;
    *)
      printf '%s\n' "$XG_WIN_PATH"
      ;;
  esac
}

set_program_path() {
  local plist="$WRAPPER/Contents/Info.plist"
  local winpath="$1"
  local exe
  [[ -f "$plist" ]] || return 0
  if [[ -z "$winpath" ]]; then
    exe="$(find_xg_exe || true)"
    if [[ -n "$exe" ]]; then
      winpath="$(win_path_for_exe "$exe")"
    else
      winpath="$XG_WIN_PATH"
    fi
  fi
  if /usr/libexec/PlistBuddy -c "Set :\"Program Name and Path\" \"${winpath}\"" "$plist" >>"$LOG" 2>&1; then
    log "Set Program Name and Path to $winpath"
    return 0
  fi
  if /usr/libexec/PlistBuddy -c "Add :\"Program Name and Path\" string \"${winpath}\"" "$plist" >>"$LOG" 2>&1; then
    log "Added Program Name and Path $winpath"
    return 0
  fi
  log "PlistBuddy could not set Program Name and Path"
  return 0
}

clean_env() {
  env -i \
    HOME="$HOME" \
    USER="${USER:-}" \
    LOGNAME="${LOGNAME:-${USER:-}}" \
    TMPDIR="${TMPDIR:-/tmp}" \
    LANG="${LANG:-en_US.UTF-8}" \
    PATH="/usr/bin:/bin:/usr/sbin:/sbin" \
    WINEDEBUG="-all" \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    DISPLAY="${DISPLAY:-}" \
    "$@"
}

polish_wrapper_plist() {
  local plist="$WRAPPER/Contents/Info.plist"
  [[ -f "$plist" ]] || return 0
  plutil -replace "CFBundleName" -string "Extreme Gammon" "$plist" >/dev/null 2>&1 || true
  plutil -replace "CFBundleDisplayName" -string "Extreme Gammon" "$plist" >/dev/null 2>&1 || true
  plutil -replace "CFBundleIdentifier" -string "com.playxg.extremegammon.wrapper" "$plist" >/dev/null 2>&1 || true
  plutil -replace "CFBundlePackageType" -string "APPL" "$plist" >/dev/null 2>&1 || true
  plutil -replace "LSMinimumSystemVersion" -string "10.15.4" "$plist" >/dev/null 2>&1 || true
  plutil -replace "NSHighResolutionCapable" -bool true "$plist" >/dev/null 2>&1 || true
  plutil -replace "LSMultipleInstancesProhibited" -bool true "$plist" >/dev/null 2>&1 || true
  plutil -replace "Skip Gecko" -integer 1 "$plist" >/dev/null 2>&1 || true
  plutil -replace "Skip Mono" -integer 1 "$plist" >/dev/null 2>&1 || true
  # Don't pop Configure.app / debug logs on launch
  plutil -replace "Debug Mode" -integer 0 "$plist" >/dev/null 2>&1 || true
  plutil -replace "always make Log files" -integer 0 "$plist" >/dev/null 2>&1 || true
  set_program_path ""
}

launch_xg() {
  polish_wrapper_plist
  /usr/bin/xattr -drs com.apple.quarantine "$WRAPPER" >/dev/null 2>&1 || true
  rm -f "$HOME/Desktop/Extreme Gammon status.txt"
  clean_env /usr/bin/open "$WRAPPER"
  exit 0
}

# Signing the .app with --deep fails: MacOS/launcher is a symlink to Sikarugir.
# An ad-hoc re-sign is not required for launch once Program Name and Path is set.
skip_codesign() {
  log "Skipping codesign (wrapper launcher is a symlink)."
}

stop_pid() {
  local pid="${1:-}"
  local n=0
  [[ -n "$pid" ]] || return 0
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    while [ "$n" -lt 8 ]; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
      n=$((n + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
    fi
  fi
  wait "$pid" 2>/dev/null || true
}

mkdir -p "$HOME/Desktop"
: > "$LOG"
note "Starting Extreme Gammon..."
log "PATH=$PATH"
log "arch=$(uname -m)"
require_macos

if xg_ready; then
  log "Already installed at $(find_xg_exe), launching."
  launch_xg
fi

mkdir -p "$CACHE/Engines" "$CACHE/Template" "$HOME/Applications" "$CACHE/downloads"

if [[ "$(uname -m)" == "arm64" ]] && ! /usr/bin/pgrep -q oahd; then
  note "Installing Rosetta (one-time, may ask for your Mac password)..."
  /usr/sbin/softwareupdate --install-rosetta --agree-to-license >>"$LOG" 2>&1 || true
fi

fetch() {
  local url="$1" dest="$2" label="$3"
  if [[ -s "$dest" ]]; then
    log "Already have $label"
    return 0
  fi
  note "Downloading ${label}..."
  if ! curl -fsSL --retry 3 --retry-delay 2 -o "$dest.partial" "$url" >>"$LOG" 2>&1; then
    note "Download failed: $label. Check the internet and double-click Extreme Gammon again."
    open -e "$LOG"
    exit 1
  fi
  mv "$dest.partial" "$dest"
}

fetch "$ENGINE_URL" "$CACHE/Engines/${ENGINE}.tar.xz" "Wine (~160 MB)"
fetch "$TEMPLATE_URL" "$CACHE/Template/${TEMPLATE}.tar.xz" "wrapper (~80 MB)"
fetch "$XG_URL" "$CACHE/downloads/XG2install.exe" "Extreme Gammon"

/usr/bin/xattr -drs com.apple.quarantine "$CACHE" >/dev/null 2>&1 || true

if [[ -d "$WRAPPER" && ! -f "$WRAPPER/Contents/SharedSupport/wine/version" ]]; then
  log "Wrapper exists but Wine is missing - rebuilding."
  rm -rf "$WRAPPER"
fi

if [[ ! -d "$WRAPPER" ]]; then
  note "Building the game app..."
  tmp="$(mktemp -d)"
  tar -xf "$CACHE/Template/${TEMPLATE}.tar.xz" -C "$tmp" >>"$LOG" 2>&1 || {
    note "Could not unpack the wrapper. See the install log on your Desktop."
    open -e "$LOG"
    exit 1
  }
  src=""
  for c in "$tmp/${TEMPLATE}.app" "$tmp"/*.app; do
    [[ -d "$c" ]] && { src="$c"; break; }
  done
  if [[ -z "$src" ]]; then
    note "Wrapper template was not in the expected format."
    open -e "$LOG"
    exit 1
  fi
  rm -rf "$WRAPPER"
  cp -R "$src" "$WRAPPER"
  mkdir -p "$WRAPPER/Contents/SharedSupport"
  tar -xf "$CACHE/Engines/${ENGINE}.tar.xz" -C "$WRAPPER/Contents/SharedSupport" >>"$LOG" 2>&1
  if [[ -d "$WRAPPER/Contents/SharedSupport/wswine.bundle" ]]; then
    rm -rf "$WRAPPER/Contents/SharedSupport/wine"
    mv "$WRAPPER/Contents/SharedSupport/wswine.bundle" "$WRAPPER/Contents/SharedSupport/wine"
  fi
  if [[ ! -f "$WRAPPER/Contents/SharedSupport/wine/version" ]]; then
    log "Wine layout after extract:"
    /bin/ls -la "$WRAPPER/Contents/SharedSupport" >>"$LOG" 2>&1 || true
    note "Wine did not unpack where the wrapper expects it. See the install log."
    open -e "$LOG"
    exit 1
  fi
  log "engine=$(cat "$WRAPPER/Contents/SharedSupport/wine/version")"
  rm -rf "$tmp"
fi

/usr/bin/xattr -drs com.apple.quarantine "$WRAPPER" >/dev/null 2>&1 || true
skip_codesign
polish_wrapper_plist

LAUNCH="$WRAPPER/Contents/MacOS/Sikarugir"
chmod +x "$LAUNCH" 2>/dev/null || true

resolve_prefix
if [[ ! -d "$PREFIX/drive_c/windows" ]]; then
  note "Creating the game folder..."
  if ! clean_env "$LAUNCH" WSS-wineprefixcreate >>"$LOG" 2>&1; then
    note "Could not create the game folder. See the install log on your Desktop."
    open -e "$LOG"
    exit 1
  fi
  resolve_prefix
fi

if [[ ! -d "$PREFIX/drive_c/windows" ]]; then
  note "The game folder still was not created. See the install log on your Desktop."
  open -e "$LOG"
  exit 1
fi

# Quiet Wine's Mac driver: fewer helper windows, keep keyboard in the game.
REG="$PREFIX/drive_c/windows/temp/xg-mac.reg"
mkdir -p "$PREFIX/drive_c/windows/temp"
cat > "$REG" << 'REG'
REGEDIT4

[HKEY_CURRENT_USER\Software\Wine\Mac Driver]
"Capture Input in Background"="n"
"Use Command Left Click"="y"
"Left Option Is Alt"="y"
"Allow Immovable Windows"="y"
"Use Retina Mode"="y"

[HKEY_CURRENT_USER\Software\Wine\Explorer]
"Desktop"=""
REG
WINEBIN=""
for b in wine64 wine wine32on64; do
  if [[ -x "$WRAPPER/Contents/SharedSupport/wine/bin/$b" ]]; then
    WINEBIN="$WRAPPER/Contents/SharedSupport/wine/bin/$b"
    break
  fi
done
log "prefix=$PREFIX winebin=${WINEBIN:-none}"
if [[ -n "$WINEBIN" ]]; then
  clean_env env WINEPREFIX="$PREFIX" "$WINEBIN" regedit "C:\\windows\\temp\\xg-mac.reg" >>"$LOG" 2>&1 || true
fi

# If a previous run already dropped the exe, just point the wrapper at it and launch.
if xg_ready; then
  log "Found existing install at $(find_xg_exe); skipping installer."
  polish_wrapper_plist
  note "Opening Extreme Gammon..."
  launch_xg
fi

note "Installing Extreme Gammon..."
mkdir -p "$PREFIX/drive_c/users/crossover/Downloads"
cp "$CACHE/downloads/XG2install.exe" "$PREFIX/drive_c/XG2install.exe"

# Do not wait on the installer process: WSS-installer / start.exe can hang
# with an I/O error long after the exe is already on disk. Poll for the exe.
inst_pid=""
if [[ -n "$WINEBIN" ]]; then
  log "Silent install with $WINEBIN prefix=$PREFIX"
  clean_env env WINEPREFIX="$PREFIX" "$WINEBIN" "C:\\XG2install.exe" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- >>"$LOG" 2>&1 &
  inst_pid=$!
else
  log "Install via wrapper (no wine binary found)"
  clean_env "$LAUNCH" WSS-installer "C:\\XG2install.exe" >>"$LOG" 2>&1 &
  inst_pid=$!
fi

n=0
while [ "$n" -lt 90 ]; do
  if xg_ready; then
    log "Installer dropped the exe after ${n}s"
    break
  fi
  if ! kill -0 "$inst_pid" 2>/dev/null; then
    wait "$inst_pid" 2>/dev/null || true
    inst_pid=""
    # Give files a moment to flush, then keep polling briefly.
    sleep 2
    if xg_ready; then
      break
    fi
    # One short leftover wait in case the process exited just before the copy finished.
    n2=0
    while [ "$n2" -lt 10 ]; do
      xg_ready && break
      sleep 1
      n2=$((n2 + 1))
    done
    break
  fi
  sleep 1
  n=$((n + 1))
done

if xg_ready; then
  # Let a still-running installer exit cleanly for a few seconds, then stop it.
  if [[ -n "$inst_pid" ]]; then
    w=0
    while [ "$w" -lt 10 ]; do
      kill -0 "$inst_pid" 2>/dev/null || break
      sleep 1
      w=$((w + 1))
    done
    stop_pid "$inst_pid"
    inst_pid=""
  fi
else
  if [[ -n "$inst_pid" ]]; then
    stop_pid "$inst_pid"
    inst_pid=""
  fi
  # Final check: treat a present exe as success even if the installer errored.
  if ! xg_ready; then
    note "Install did not finish. Double-click Extreme Gammon to try again. Details are in the install log on your Desktop."
    open -e "$LOG"
    exit 1
  fi
fi

polish_wrapper_plist
skip_codesign

note "Opening Extreme Gammon..."
log "Install finished at $(find_xg_exe)."
launch_xg
